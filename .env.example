# IPTV HLS Reverse Proxy Configuration
# Copy to .env and fill in your values

# Public base URL for m3u8/ts URL rewriting (e.g. https://your-domain.com/stream)
EXTERNAL_BASE_URL=

# Port for the proxy to listen on
PROXY_PORT=8830

# Upstream timeout in seconds
UPSTREAM_TIMEOUT=15

# Max concurrent connections
MAX_CONCURRENT=20
